APP_ENV=prod
NODE_ENV=production
# Registro A deste domínio deve apontar para o IP da VM.
HTTPS_DOMAIN=cotacao.grupo05.com.br
# Ative somente depois de preparar deploy/certificates e suas credenciais na VM.
HTTPS_WILDCARD_ENABLED=false
CERTIFICATE_ROOT=/home/ubuntu/projects/cotacao/certificates
# Acesso local na VM para diagnóstico; acesso público usa HTTPS na porta 443.
FRONTEND_PORT=4200
DB_NAME=quotation_prod
DB_USER=quotation_user
# Gere valores diferentes com: openssl rand -hex 32
DB_ROOT_PASSWORD=CHANGE_ME_ROOT
DB_PASSWORD=CHANGE_ME_DATABASE
JWT_SECRET=CHANGE_ME_JWT
JWT_EXPIRES_IN=2h
